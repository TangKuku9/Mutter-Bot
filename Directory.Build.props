<Project>

  <!--
    CONTRIBUTING 要求「0 warning / 0 error」。把这条规则放在仓库里而不是 CI 命令行上，
    有三个好处：
      1) 本地构建与 CI 行为一致，贡献者在本地就能发现，而不是推到 CI 才知道；
      2) 不依赖 `dotnet build -warnaserror` 的命令行参数；
      3) 属性值里的分号在命令行上会被 MSBuild 误解析（MSB1006），写在这里没有这个问题。
  -->
  <PropertyGroup>
    <!--
      版本号唯一来源：程序集、前端构建（vite.config.mjs）与 Release 工作流都读取这里。
      发布版本采用日期命名（YYMMDD，例如 261109）；同日再次发布可追加 .1 区分。
      发版时修改此处，并同步 web/package.json；CI 会校验两者一致。
    -->
    <Version>261114</Version>

    <!--
      程序集版本每段上限 65535，纯日期 261109 无法写进 AssemblyVersion/FileVersion。
      日期版本由 AssemblyInformationalVersion 承载（AppVersion.Current 读取这里），
      这两个字段只保留 .NET 要求的合法常量。
    -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      例外：NuGet 审计告警（NU190x，依赖存在已知漏洞）。
      这是上游依赖的问题，应该由 Dependabot 提 PR 升版本处理，
      不适合让任意一次构建直接失败。
    -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
