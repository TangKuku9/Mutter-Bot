<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mutter-bot</AssemblyName>
    <RootNamespace>Mutter.ConsoleHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mutter.Core\Mutter.Core.csproj" />
    <ProjectReference Include="..\Mutter.Infrastructure\Mutter.Infrastructure.csproj" />
    <ProjectReference Include="..\Mutter.Web\Mutter.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.*" />
    <PackageReference Include="Terminal.Gui" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Mutter.Web\wwwroot\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Mutter.Web\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 环境后缀配置不入库，本地没有时不应因此构建失败 -->
    <Content Include="..\Mutter.Web\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Mutter.Web\appsettings.Development.json')" />
  </ItemGroup>

</Project>
