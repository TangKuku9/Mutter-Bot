{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiAuth": {
    "Token": ""
  },
  "PanelAuth": {
    "Username": "admin",
    "Password": "CHANGE_ME_STRONG_PASSWORD",
    "SessionTimeoutMinutes": 120,
    "RequireSecureCookie": false
  },
  "Mutter": {
    "AppId": "YOUR_APP_ID",
    "ClientSecret": "YOUR_CLIENT_SECRET",
    "ApiBaseUrl": "https://api.bot.qq.com",
    "RichUi": {
      "Enabled": false,
      "Markdown": true,
      "KeyboardMode": "None",
      "CmdInputLinks": true,
      "AtUserTags": true,
      "MessageReference": false,
      "InteractionIntent": false,
      "GroupAllowList": [],
      "CapabilityTtlMinutes": 360,
      "MaxRows": 5,
      "MaxButtonsPerRow": 5,
      "MaxMarkdownChars": 2000
    },
    "Runtime": {
      "Parallelism": 3,
      "Capacity": 256,
      "PerConversationCap": 16,
      "QueueAgeSeconds": 120,
      "WorkDeadlineSeconds": 240,
      "BackgroundQueueAgeSeconds": 45,
      "AiTimeoutSeconds": 120,
      "AiPerAttemptTimeoutSeconds": 90,
      "DegradedQueueAgeSeconds": 45,
      "DegradedPerAttemptTimeoutSeconds": 45,
      "HealthWindowSize": 10,
      "HealthFailureThreshold": 3,
      "HealthRecoveryThreshold": 4,
      "HealthMinDegradeSeconds": 60,
      "RewriteMinRemainingSeconds": 45
    }
  }
}
